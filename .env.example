# Required (pick ONE auth method):
# 1) Email + password (recommended - auto-refreshes):
CORTEXIFY_EMAIL=you@example.com
CORTEXIFY_PASSWORD=your-password
# 2) Or a live session access token (expires ~1h, dev/testing only):
# CORTEXIFY_ACCESS_TOKEN=eyJ...

# Optional overrides (defaults point at production Cortexify):
# CORTEXIFY_APP_URL=https://www.cortexify.in
# CORTEXIFY_SUPABASE_URL=https://tfbujtucezcpxdzlhqrj.supabase.co
# CORTEXIFY_SUPABASE_ANON_KEY=...

# Required only for the remote (hosted) server on Vercel:
# Shared secret that protects the /api/mcp endpoint. Generate a long random
# string, e.g.: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Required (pick ONE auth method):
# 1) Email + password (recommended - auto-refreshes):
CORTEXIFY_EMAIL=you@example.com
CORTEXIFY_PASSWORD=your-password
# 2) Or a live session access token (expires ~1h, dev/testing only):
# CORTEXIFY_ACCESS_TOKEN=eyJ...

# Optional overrides (defaults point at production Cortexify):
# CORTEXIFY_APP_URL=https://www.cortexify.in
# CORTEXIFY_SUPABASE_URL=https://tfbujtucezcpxdzlhqrj.supabase.co
# CORTEXIFY_SUPABASE_ANON_KEY=...
